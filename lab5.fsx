printfn "   Умножение: 6 * 7 = %d" (multiply 6 7)
printfn "   Деление: 15 / 4 = %.2f" (divide 15 4)
printfn ""

// Тест 2: Каррирование (специализированные функции)
printfn "2. Каррирование (специализированные функции):"
printfn "   add5 10 = %d" (add5 10)
printfn "   add10 5 = %d" (add10 5)
printfn "   multiplyBy2 7 = %d" (multiplyBy2 7)
printfn "   multiplyBy3 5 = %d" (multiplyBy3 5)
printfn "   subtractFrom10 3 = %d" (subtractFrom10 3)
printfn "   divideBy2 10 = %.2f" (divideBy2 10)
printfn ""

// Тест 3: Композиция функций
printfn "3. Композиция функций:"
printfn "   add5ThenMultiplyBy2 (10) = (10+5)*2 = %d" (add5ThenMultiplyBy2 10)
printfn "   multiplyBy2ThenAdd5 (10) = (10*2)+5 = %d" (multiplyBy2ThenAdd5 10)
printfn ""

// Тест 4: Факториал (рекурсия)
printfn "4. Рекурсивная функция факториала:"
printfn "   factorial 0 = %d" (factorial 0)
printfn "   factorial 1 = %d" (factorial 1)
printfn "   factorial 5 = %d" (factorial 5)
printfn "   factorial 7 = %d" (factorial 7)
printfn ""

