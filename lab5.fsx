// ============================================================

// ============================================================
// 1. СУММА ДВУХ ЧИСЕЛ
// ============================================================

/// Вычисляет сумму двух целых чисел
let add (a: int) (b: int) : int =
    a + b

// ============================================================
// 2. РАЗНОСТЬ ДВУХ ЧИСЕЛ
// ============================================================

/// Вычисляет разность двух целых чисел
let subtract (a: int) (b: int) : int =
    a - b

// ============================================================
// 3. ПРОИЗВЕДЕНИЕ ДВУХ ЧИСЕЛ
// ============================================================

/// Вычисляет произведение двух целых чисел
let multiply (a: int) (b: int) : int =
    a * b

// ============================================================
// 4. ДЕЛЕНИЕ ДВУХ ЧИСЕЛ
// ============================================================

/// Вычисляет частное двух целых чисел (возвращает float)
let divide (a: int) (b: int) : float =
    if b = 0 then
        failwith "Ошибка: деление на ноль невозможно"
    else
        float a / float b

// ============================================================
// 5. РЕКУРСИВНАЯ ФУНКЦИЯ ФАКТОРИАЛА
// ============================================================

/// Вычисляет факториал числа (рекурсивно)
let rec factorial (n: int) : int =
    if n <= 1 then
        1
    else
        n * factorial (n - 1)

// ============================================================
// КАРРИРОВАНИЕ
// ============================================================

/// Создание специализированных функций с помощью каррирования
let add5 = add 5                    // функция, прибавляющая 5
let add10 = add 10                  // функция, прибавляющая 10
let multiplyBy2 = multiply 2        // функция, умножающая на 2
let multiplyBy3 = multiply 3        // функция, умножающая на 3
let subtractFrom10 = subtract 10    // функция: 10 - x
let divideBy2 = divide 2            // функция: x / 2

// ============================================================
// КОМПОЗИЦИЯ ФУНКЦИЙ
// ============================================================

/// Композиция функций: сначала add5, затем multiplyBy2
let add5ThenMultiplyBy2 = add5 >> multiplyBy2

/// Композиция функций: сначала multiplyBy2, затем add5
let multiplyBy2ThenAdd5 = multiplyBy2 >> add5

// ============================================================
// ТЕСТИРОВАНИЕ ВСЕХ ФУНКЦИЙ
// ============================================================

printfn "========================================"
printfn "ЛАБОРАТОРНАЯ РАБОТА №5"
printfn "Функциональное программирование на F#"
printfn "========================================"
printfn ""

// Тест 1: Базовые операции
printfn "1. Базовые математические операции:"
